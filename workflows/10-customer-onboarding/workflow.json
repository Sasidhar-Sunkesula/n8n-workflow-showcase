    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "models/gemma-4-31b-it"
        },
        "messages": {
          "values": [
            {
              "content": "=You are a customer success manager at a SaaS company. Write a warm, personalized welcome email to a new customer who just signed up.\n\nCUSTOMER: {{ $json.name }} at {{ $json.company }}\nPLAN: {{ $json.plan }}\n\nWrite a welcome email (120-180 words) that:\n- Welcomes them warmly by first name\n- References their company and plan specifically\n- Suggests 2-3 relevant first steps to get value quickly\n- Offers help and a clear next step (book a call / reply)\n- Warm, human, not generic or salesy\n\nGenerate exactly this JSON (no markdown fences):\n{\n  \"subject\": \"<email subject line>\",\n  \"body\": \"<email body>\",\n  \"confidence\": <0.0-1.0>\n}\nYour ENTIRE response must be that single JSON object."
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "id": "s10-gemini",
      "name": "Gemini: Write Welcome Email",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        1240,
        -60
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "B8oepyrWrBGFl6Ud",
          "name": "Google Gemini (portfolio)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst raw = $json.content?.parts?.filter(p => !p.thought).map(p => p.text || '').join('') ?? $json.text ?? '';\nconst cleaned = raw.replace(/```json/gi,'').replace(/```/g,'').trim();\nlet data = null;\nfor (const c of (cleaned.match(/\\{[\\s\\S]*\\}/g) || []).reverse()) {\n  try { const p = JSON.parse(c); if (p && p.body) { data = p; break; } } catch(e){}\n}\nconst signup = $('Idempotency Check').item.json;\nif (!data) return { json: { ...signup, parse_ok: false, error: 'AI output unparseable',\n  subject: 'Welcome aboard!', body: 'Hi ' + signup.name + ', welcome to the team! We are excited to have you. Reply to this email if you need anything.', confidence: 0.5 } };\nconst confidence = typeof data.confidence === 'number' ? data.confidence : 0.7;\nreturn { json: { ...signup, ...data, confidence, parse_ok: true } };\n"
      },
      "id": "s10-parse",
      "name": "Parse Welcome Email",
      "type": "n8n-nodes-base.code",
