    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst s = $json;\n// PRODUCTION: check Sheets \"Onboarding Pipeline\" for existing EventKey.\n// Demo: assume new (not a duplicate).\nconst isDuplicate = false; // PRODUCTION: Sheets lookup by EventKey\nreturn { json: { ...s, is_duplicate: isDuplicate } };\n"
      },
