    {
      "parameters": {},
      "id": "s10-manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -320,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\n// Demo signup. PRODUCTION: replace with webhook body from your signup flow.\nconst signup = {\n  name: \"Sarah Mitchell\",\n  email: \"sarah@brightwavecoffee.com\",\n  company: \"Brightwave Coffee\",\n  plan: \"Growth\",\n  signupSource: \"website\"\n};\nconst input = $json.body && $json.body.email ? $json.body : signup;\nreturn { json: { ...input, EventKey: \"onboarding:\" + input.email + \":\" + new Date().toISOString().slice(0,10) } };\n"
      },
      "id": "s10-signup",
      "name": "New Signup (Demo)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -60,
        100
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst s = $json;\nconst allowedPlans = [\"Starter\", \"Growth\", \"Enterprise\"];\nconst emailOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(String(s.email || ''));\nconst ok = emailOk && s.name && String(s.name).length >= 2 && (s.plan ? allowedPlans.includes(s.plan) : true);\nif (!ok) return { json: { Timestamp: new Date().toISOString(), EventKey: s.EventKey || 'unknown',\n  Workflow: 'customer-onboarding', Status: 'rejected_invalid_signup', Reason: 'bad email/name/plan' } };\nreturn { json: { ...s, input_valid: true } };\n"
      },
      "id": "s10-validate",
      "name": "Validate Signup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.input_valid === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "s10-if-valid",
      "name": "Signup Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        460,
