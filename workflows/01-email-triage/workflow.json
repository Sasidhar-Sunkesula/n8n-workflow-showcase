      {
        "parameters": {
          "modelId": {
            "__rl": true,
            "mode": "id",
            "value": "models/gemma-4-31b-it"
          },
          "messages": {
            "values": [
              {
                "content": "=You are a senior customer support agent at BrightLoop (a SaaS billing analytics product). Write a complete, warm, professional reply email (under 160 words) to the customer email below. Match the tone to the intent: apologize and de-escalate for complaints, answer clearly for questions, confirm next steps for requests. Sign as \"Alex — BrightLoop Support\". Wrap your final reply between the exact markers <<<REPLY>>> and <<<END>>>. Anything outside the markers is discarded, so the complete email MUST appear between them. Do not think out loud before the markers.\n\nINTENT: {{ $json.classification }} (priority: {{ $json.priority }})\nFROM: {{ $json.from }}\nSUBJECT: {{ $json.subject }}\nBODY:\n{{ $json.body }}\n\nIMPORTANT: Do not think out loud, do not plan, do not repeat these instructions. Start your response DIRECTLY with the greeting line (e.g. \"Hi Rachel,\") and output only the reply."
              }
            ]
          },
          "builtInTools": {},
          "options": {}
        },
        "id": "a1000000-0000-4000-8000-000000000006",
        "name": "Gemini: Draft Reply",
        "type": "@n8n/n8n-nodes-langchain.googleGemini",
        "typeVersion": 1.2,
        "position": [
          1120,
          -64
        ],
        "credentials": {
          "googlePalmApi": {
            "id": "B8oepyrWrBGFl6Ud",
            "name": "Google Gemini (portfolio)"
          }
        },
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 3000
      },
      {
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "// Extract the final reply text from Gemini's output\nconst item = $json;\nlet rawDraft = '';\nif (item.content && Array.isArray(item.content.parts)) {\n  rawDraft = item.content.parts.filter(p => !p.thought).map(p => p.text || '').join('');\n} else if (item.text) { rawDraft = item.text; }\nrawDraft = (rawDraft || '').trim();\nlet draft = '';\nconst lastIdx = rawDraft.lastIndexOf('<<<REPLY>>>');\nif (lastIdx !== -1) {\n  draft = rawDraft.slice(lastIdx + 11);\n  const endIdx = draft.indexOf('<<<END>>>');\n  if (endIdx !== -1) draft = draft.slice(0, endIdx);\n  draft = draft.trim();\n}\nif (draft.length < 40) {\n  const g = /(Hi|Hello|Dear|Hey)\\s+[A-Z][a-zA-Z]*,/g;\n  let m, last = -1;\n  while ((m = g.exec(rawDraft)) !== null) last = m.index;\n  if (last !== -1) {\n    draft = rawDraft.slice(last);\n    const s = draft.indexOf('<<<END>>>');\n    if (s !== -1) draft = draft.slice(0, s);\n    draft = draft.trim();\n  }\n}\nif (draft.length < 40) draft = rawDraft;\nconst email = $('Parse Classification').item.json;\nreturn { json: { ...email, draftReply: draft } };"
        },
