      {
        "parameters": {
          "modelId": {
            "__rl": true,
            "mode": "id",
            "value": "models/gemma-4-31b-it"
          },
          "messages": {
            "values": [
              {
                "content": "=You are an email triage assistant for a SaaS support team. Classify the email below into EXACTLY one intent category: Question, Request, Complaint, FYI, or Spam. Also assign a priority (high, medium, or low) and write a one-sentence summary.\n\nRespond with ONLY valid JSON — no markdown fences, no commentary — in exactly this shape:\n{\"classification\": \"<Question|Request|Complaint|FYI|Spam>\", \"priority\": \"<high|medium|low>\", \"summary\": \"<one sentence>\"}\n\nDefinitions: Question = customer asks how to do something or whether something is possible. Request = customer asks you to take an action (upgrade, refund, provision, change). Complaint = customer is upset about a problem. FYI = informational only, no action needed. Spam = unsolicited junk/scam.\n\nEMAIL\nFrom: {{ $json.from }}\nSubject: {{ $json.subject }}\nBody:\n{{ $json.body }}\n\nIMPORTANT: Do not think out loud. Do not explain. Your ENTIRE response must be that single line of JSON and nothing else."
              }
            ]
          },
          "builtInTools": {},
          "options": {}
        },
        "id": "a1000000-0000-4000-8000-000000000003",
        "name": "Gemini: Classify Intent",
        "type": "@n8n/n8n-nodes-langchain.googleGemini",
        "typeVersion": 1.2,
        "position": [
          312,
          64
        ],
        "credentials": {
          "googlePalmApi": {
            "id": "B8oepyrWrBGFl6Ud",
            "name": "Google Gemini (portfolio)"
          }
        },
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 3000
      },
      {
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "// Parse the model's verdict (handles raw JSON, fenced JSON, or reasoning text)\nconst raw = $json.content?.parts?.[0]?.text ?? '';\nconst cleaned = raw.replace(/```json/gi, '```').replace(/```/g, '').trim();\nconst allowed = ['Question', 'Request', 'Complaint', 'FYI', 'Spam'];\nlet verdict = null;\n// 1) Try every {...} candidate, last one wins (models often restate the schema first)\nconst candidates = cleaned.match(/\\{[^{}]*\\}/g) ?? [];\nfor (const c of candidates.reverse()) {\n  try {\n    const p = JSON.parse(c);\n    if (p && allowed.includes(p.classification)) { verdict = p; break; }\n  } catch (e) { /* keep looking */ }\n}\n// 2) Fallback: scrape labeled lines from reasoning-style output (take LAST occurrence)\nif (!verdict) {\n  const grabAll = (re) => { let m, last = null; while ((m = re.exec(cleaned)) !== null) last = m[1]; return last; };\n  const cls = grabAll(/classification[\\s\\\"':*]*\\s*(Question|Request|Complaint|FYI|Spam)/gi);\n  const pri = grabAll(/priority[\\s\\\"':*]*\\s*(high|medium|low)/gi);\n  const sum = grabAll(/summary[\\s\\\"':*]*\\s*([^\\n\\\"]{10,300})/gi);\n  verdict = { classification: cls, priority: (pri ?? 'medium').toLowerCase(), summary: (sum ?? '').trim() };\n}\nif (!allowed.includes(verdict.classification)) verdict.classification = 'FYI';\nconst email = $('Sample Inbox (Demo Data)').item.json;\n// --- Confidence score (mock heuristic for demo) ---\n// PRODUCTION: get this from the model's logprob or a calibration layer.\n// Here we simulate: if classification was parsed from clean JSON = high confidence,\n// if it fell through to the regex fallback = lower confidence.\nconst highConfidence = verdict.classification !== 'FYI' || cleaned.includes(verdict.classification);\nconst fallbackUsed = !candidates.some(c => { try { JSON.parse(c); return true; } catch { return false; } });\nconst confidence = fallbackUsed ? 0.55 : 0.92;\nreturn {\n  json: {\n    messageId: email.messageId,\n    from: email.from,\n    subject: email.subject,\n    body: email.body,\n    receivedAt: email.receivedAt,\n    classification: verdict.classification,\n    priority: verdict.priority ?? 'medium',\n    summary: verdict.summary ?? '',\n    confidence: confidence\n  }\n};"
        },
