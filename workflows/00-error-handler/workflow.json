        "typeVersion": 2,
        "position": [
          1100,
          300
        ],
        "id": "patch-00-slack-if",
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "loose",
              "version": 2
            },
            "conditions": [
              {
                "leftValue": "={{ !($json.error || $json.message) }}",
                "rightValue": "",
