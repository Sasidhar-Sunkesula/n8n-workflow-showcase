        ]
      },
      {
        "parameters": {
          "jsCode": "const e=$input.first().json,ex=e.execution||{},wf=e.workflow||{};const raw=String(e.message||ex.error?.message||'Unknown error');const category=/401|403|credential|token|authori[sz]/i.test(raw)?'AUTH':/429|timeout|ECONNRESET|5\\d\\d/i.test(raw)?'TRANSIENT':/validation|invalid|required|schema/i.test(raw)?'VALIDATION':'PROCESSING';const red=s=>s.replace(/AIza[\\w-]+|AQ\\.[\\w.-]+|Bearer\\s+[^\\s]+|https?:\\/\\/[^\\s]+/gi,'[redacted]').replace(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/gi,'[redacted-email]');const node=ex.lastNodeExecuted||e.lastNodeExecuted||'unknown',key=[wf.id||'unknown',ex.id||'unknown',node].join(':');return[{json:{EventKey:key,Timestamp:new Date().toISOString(),Severity:['AUTH','PROCESSING'].includes(category)?'CRITICAL':'WARNING',Category:category,Workflow:String(wf.name||'unknown').slice(0,160),FailedNode:String(node).slice(0,160),ExecutionId:String(ex.id||''),ErrorSummary:red(raw).slice(0,500),Status:'open',ReplayPolicy:category==='TRANSIENT'?'retry_from_checkpoint':'manual_review_required',AlertText:'['+category+'] '+String(wf.name||'workflow')+' failed at '+node+'; event '+key}}];"
        },
        "id": "parse-error",
        "name": "Parse & Classify Error",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          440,
          300
        ]
      },
      {
        "name": "Sheets: Append Error DLQ",
        "type": "n8n-nodes-base.googleSheets",
        "typeVersion": 4.5,
        "parameters": {
          "operation": "append",
          "documentId": {
            "__rl": true,
            "mode": "id",
            "value": "1jBF0CMiwBPn9hQ3xXOHZG81SvmObiE9zNrt7E9qWXZ4"
          },
          "sheetName": {
            "__rl": true,
            "mode": "name",
            "value": "Error DLQ"
          },
          "columns": {
            "mappingMode": "autoMapInputData",
            "matchingColumns": [],
            "schema": [],
            "attemptToConvertTypes": false,
            "convertFieldsToString": false
          },
          "options": {
            "handlingExtraData": "ignoreIt"
          }
        },
        "id": "h-SheetsAppendErrorDLQ",
        "position": [
