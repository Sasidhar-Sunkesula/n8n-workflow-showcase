                  "type": "boolean",
                  "operation": "true",
                  "singleValue": true
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "notes": "TRUE (output 0) = Slack sent OK \u2192 end. FALSE (output 1) = Slack failed \u2192 Gmail fallback draft."
      }
