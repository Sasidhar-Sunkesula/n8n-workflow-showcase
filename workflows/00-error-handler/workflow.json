      {
        "name": "Slack: Alert Automation Errors",
        "type": "n8n-nodes-base.slack",
        "typeVersion": 2.2,
        "parameters": {
          "authentication": "oAuth2",
          "resource": "message",
          "operation": "post",
          "select": "channel",
          "channelId": {
            "__rl": true,
            "mode": "id",
            "value": "C0BKVT980BE"
          },
          "messageType": "text",
          "text": "={{ $json.AlertText }}",
          "otherOptions": {
            "includeLinkToWorkflow": false
          }
        },
        "id": "slack-alert",
        "position": [
          920,
          300
        ],
        "credentials": {
          "slackOAuth2Api": {
            "id": "0LO7Ag4PE1NaZFpO",
            "name": "Slack account"
          }
        },
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 3000,
        "onError": "continueRegularOutput",
        "notes": "Posts the alert to #automation-errors. On failure, continues to the IF so the Gmail fallback can fire.",
        "webhookId": "fae8d887-44d0-4ebf-b7f8-7cd890ee4b01"
      },
      {
        "name": "Gmail: Create Internal Alert Draft",
        "type": "n8n-nodes-base.gmail",
        "typeVersion": 2.1,
        "parameters": {
          "resource": "draft",
          "operation": "create",
          "subject": "=[n8n] Slack alert delivery failed",
          "emailType": "text",
          "message": "=Internal alert draft only.\n\n{{ $('Parse & Classify Error').item.json.AlertText }}",
          "options": {
            "sendTo": "={{ $env.N8N_ONCALL_EMAIL || \"oncall@example.invalid\" }}"
          }
        },
        "id": "gmail-fallback",
        "position": [
          1180,
          540
        ],
        "credentials": {
          "gmailOAuth2": {
            "id": "6cOkI9yXp7fgLHw4",
            "name": "Gmail account"
          }
        },
        "disabled": false,
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 3000,
        "notes": "Fallback: invoked only when the Slack alert node throws. Requires N8N_ONCALL_EMAIL env or a real recipient to actually send; otherwise creates a draft.",
        "webhookId": "c2f9be01-8011-4b13-aa42-6c08d5ae6408"
      },
