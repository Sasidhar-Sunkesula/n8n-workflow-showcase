      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst d = $json;\nreturn { json: {\n  Timestamp: new Date().toISOString(),\n  EventKey: d.EventKey,\n  Workflow: 'competitor-monitor',\n  Status: d.confidence < 0.7 ? 'change_low_confidence' : 'change_detected',\n  Competitor: d.name,\n  PageType: d.pageType,\n  Url: d.url,\n  ContentHash: d.contentHash,\n  Confidence: d.confidence,\n  Summary: (d.summary || '').slice(0, 500),\n  ReplayPolicy: 'hash_based_dedup'\n}};\n"
      },
