        "text": ":eyes: *Competitor Change Detected*\n\n*Competitor:* {{ $json.name }}\n*Page:* {{ $json.pageType }} — {{ $json.url }}\n*Confidence:* {{ $json.confidence }}\n\n*Summary:* {{ $json.summary }}\n\n*Key points:*\n{{ ($json.key_points || []).map(k => '• ' + k).join('\\n') }}\n\n*Action:* {{ $json.business_impact }}\n\n{{ $json.confidence < 0.7 ? ':warning: *LOW CONFIDENCE* — verify before acting' : ':white_check_mark: Review recommended' }}",
        "otherOptions": {}
      },
