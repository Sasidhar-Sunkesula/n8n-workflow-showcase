                "type": "string",
                "value": "={{ ($json.body && $json.body.transcript) ? $json.body.transcript : 'Meeting: Weekly Ops Sync\\nDate: 2026-07-24\\nAttendees: Sarah (Ops), Marcus (Eng), Priya (Product), Dev (Support)\\n\\nSarah: Let\u2019s review last week\u2019s action items. Marcus, did the API timeout fix ship?\\nMarcus: Yes, deployed Tuesday. Error rate dropped from 4% to 0.3%.\\nPriya: Great. We decided to move the Q3 roadmap review to August 5th because design bandwidth is tight.\\nSarah: Agreed. Action: Priya to finalize the roadmap doc by Aug 1 and share with the exec channel.\\nDev: Support ticket volume is up 18% after the pricing page change. We need a help-center article.\\nSarah: Action: Dev to draft the help-center article by July 30, owner Dev, reviewer Marcus.\\nMarcus: We also agreed to sunset the legacy v1 webhook endpoint on Sept 1 to cut infra cost.\\nPriya: And we decided to pilot the new onboarding flow with 50 beta users starting Aug 12.\\nSarah: Action: Marcus to enable the beta flag by Aug 10. Let\u2019s sync again next Thursday.' }}"
              },
              {
                "id": "meetingTitle",
                "name": "meetingTitle",
                "type": "string",
                "value": "={{ ($json.body && $json.body.title) ? $json.body.title : 'Weekly Ops Sync (Sample)' }}"
              },
              {
                "id": "meetingDate",
                "name": "meetingDate",
                "type": "string",
                "value": "={{ ($json.body && $json.body.date) ? $json.body.date : '2026-07-24' }}"
              },
              {
                "id": "meeting-id",
                "name": "meetingId",
                "type": "string",
                "value": "={{ ($json.body && $json.body.meeting_id) ? $json.body.meeting_id : \"demo-weekly-ops-sync-2026-07-24\" }}"
              }
            ]
          },
          "options": {}
        },
        "id": "prepare",
        "name": "Prepare Transcript",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [
          464,
          448
        ]
      },
      {
        "parameters": {
          "modelId": {
            "__rl": true,
            "mode": "id",
            "value": "models/gemma-4-31b-it"
          },
          "messages": {
            "values": [
              {
                "content": "=You are a meeting-notes analyst. Read the meeting transcript below and extract structured insights.\n\nReturn ONLY a single valid JSON object (no markdown, no code fences) with exactly these keys:\n{\n  \"summary\": string (a concise 2-3 sentence summary of the meeting),\n  \"actionItems\": array of objects, each with \"task\" (string), \"owner\" (string), \"dueDate\" (string, ISO date if given, else 'TBD'),\n  \"keyDecisions\": array of strings (the important decisions made)\n}\n\nMake owners proper names from the transcript. If a due date is not explicit, use 'TBD'.\n\nTRANSCRIPT:\n\"\"\"\n{{ $('Prepare Transcript').item.json.transcript }}\n\"\"\""
              }
            ]
          },
          "options": {}
        },
        "id": "gemini",
        "name": "Gemini (gemma-4-31b-it)",
        "type": "@n8n/n8n-nodes-langchain.googleGemini",
        "typeVersion": 1,
        "position": [
          660,
          360
        ],
        "credentials": {
          "googlePalmApi": {
            "id": "B8oepyrWrBGFl6Ud",
            "name": "Google Gemini (portfolio)"
          }
        },
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 3000
      },
      {
        "parameters": {
          "jsCode": "const x=$json,raw=x.text||x.content?.parts?.filter(p=>!p.thought).map(p=>p.text||'').join('')||'';let p;try{const a=raw.indexOf('{'),b=raw.lastIndexOf('}');p=JSON.parse(raw.slice(a,b+1))}catch{throw Error('Model output is not valid JSON')}if(typeof p.summary!=='string'||p.summary.trim().length<20||!Array.isArray(p.actionItems)||!Array.isArray(p.keyDecisions))throw Error('Model output failed meeting-note schema');return{json:{summary:p.summary.slice(0,2000),actionItems:p.actionItems.slice(0,30),keyDecisions:p.keyDecisions.slice(0,30),meetingId:$('Validate Input & Build Key').item.json.meetingId,EventKey:$('Validate Input & Build Key').item.json.EventKey}};"
        },
        "id": "parse",
        "name": "Parse Gemini JSON",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          880,
          360
        ]
      },
      {
        "parameters": {
          "jsCode": "const d = $json;\nconst title = $('Prepare Transcript').item.json.meetingTitle;\nconst date = $('Prepare Transcript').item.json.meetingDate;\nconst actionLines = (d.actionItems || []).map((a, i) =>\n  `${i + 1}. ${a.task || 'Task'} \u2014 Owner: ${a.owner || 'TBD'}, Due: ${a.dueDate || 'TBD'}`).join('\\n');\nconst decisionLines = (d.keyDecisions || []).map((x, i) => `${i + 1}. ${x}`).join('\\n');\nconst slackActionLines = (d.actionItems || []).map(a =>\n  `\u2022 ${a.task || 'Task'} \u2014 ${a.owner || 'TBD'} (due ${a.dueDate || 'TBD'})`).join('\\n');\nconst slackDecisionLines = (d.keyDecisions || []).map(x => `\u2022 ${x}`).join('\\n');\nconst slackMessage =\n  `:memo: *Meeting Recap \u2014 ${title} (${date})*\\n\\n` +\n  `*Summary:* ${d.summary}\\n\\n` +\n  `*Action Items:*\\n${slackActionLines || '\u2022 None'}\\n\\n` +\n  `*Key Decisions:*\\n${slackDecisionLines || '\u2022 None'}`;\nreturn [{ json: {\n  title: `${title} \u2014 ${date}`,\n  summary: d.summary,\n  actionLines: actionLines || 'None',\n  decisionLines: decisionLines || 'None',\n  slackMessage,\n  actionItemCount: (d.actionItems || []).length,\n  decisionCount: (d.keyDecisions || []).length\n}}];"
        },
        "id": "build-recap",
        "name": "Build Recap Content",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1100,
          360
        ]
