      {
        "parameters": {
          "promptType": "define",
          "text": "=You are a B2B sales SDR assistant. Score the following inbound lead as HOT, WARM, or COLD based on buying intent, budget, authority, timeline, and company fit (BANT).\n\nRespond with ONLY a valid JSON object, no markdown, no extra text, in exactly this shape:\n{\"score\":\"HOT|WARM|COLD\",\"reasoning\":\"one concise sentence\",\"key_signals\":[\"signal1\",\"signal2\"]}\n\nLEAD:\nName: {{ $json.name }}\nEmail: {{ $json.email }}\nCompany: {{ $json.company }}\nMessage: {{ $json.message }}",
          "messages": {
            "messageValues": []
          },
          "batching": {}
        },
        "id": "f6666666-6666-4666-8666-666666666666",
        "name": "AI Lead Scorer",
        "type": "@n8n/n8n-nodes-langchain.chainLlm",
        "typeVersion": 1.7,
        "position": [
          80,
          200
        ]
      },
      {
        "parameters": {
          "jsCode": "const raw=String($json.text||$json.response||$json.output||'');let p;try{const m=raw.match(/\\{[\\s\\S]*\\}/);p=m?JSON.parse(m[0]):null}catch{}const score=String(p?.score||'').toUpperCase(),reasoning=String(p?.reasoning||'').trim(),signals=Array.isArray(p?.key_signals)?p.key_signals.map(String).slice(0,5):[];const lead=$('Prepare Lead Audit Record').item.json;if(!['HOT','WARM','COLD'].includes(score)||reasoning.length<8||signals.length===0)return[{json:{...lead,Status:'needs_human_review',parse_error:'strict_score_schema_failed'}}];return[{json:{...lead,score,reasoning,key_signals:signals,outreach_draft:'Hi '+lead.name.split(' ')[0]+',\\n\\nThanks for reaching out. A salesperson must review this draft before sending.\\n\\nBest,\\nSales Team',Status:'scored'}}];"
        },
        "id": "a7777777-7777-4777-8777-777777777777",
        "name": "Parse Score & Draft Outreach",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          300,
          200
        ]
      },
      {
        "parameters": {
          "rules": {
            "values": [
              {
                "conditions": {
                  "options": {
                    "caseSensitive": false,
                    "leftValue": "",
                    "typeValidation": "loose",
                    "version": 2
                  },
                  "conditions": [
                    {
                      "id": "c-hot",
                      "leftValue": "={{ $json.score }}",
                      "rightValue": "HOT",
                      "operator": {
                        "type": "string",
                        "operation": "equals"
                      }
                    }
                  ],
                  "combinator": "and"
                },
                "outputKey": "HOT"
              }
            ]
          },
          "options": {
            "fallbackOutput": "extra",
            "renameFallbackOutput": "WARM/COLD"
          }
        },
