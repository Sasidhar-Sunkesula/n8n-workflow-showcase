      {
        "name": "Validate & Normalize Lead",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "const b=$json.body||$json,c=(v,n)=>String(v||'').trim().slice(0,n),name=c(b.name,120),email=c(b.email,254).toLowerCase(),company=c(b.company,160),message=c(b.message,4000),id=c(b.event_id||b.lead_id||b.id,160);const ok=name.length>1&&/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)&&company.length>1&&message.length>=10;const key='lead:'+require('crypto').createHash('sha256').update(id||[email,company,message].join('|')).digest('hex');return{json:ok?{name,email,company,message,LeadKey:key,received_at:new Date().toISOString(),valid:true}:{LeadKey:key,Timestamp:new Date().toISOString(),Workflow:'lead-scoring',Status:'rejected_invalid_input'}};"
        },
