        "id": "e5555555-5555-4555-8555-555555555555",
        "name": "Google Gemini Chat Model",
        "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
        "typeVersion": 1,
        "position": [
          -120,
          420
        ],
        "credentials": {
          "googlePalmApi": {
            "id": "B8oepyrWrBGFl6Ud",
