{
  "name": "AI Invoice Data Extractor → Google Sheets",
  "nodes": [
    {
      "parameters": {},
      "id": "t3-manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// ── PASTE INVOICE TEXT HERE ──\n// Or replace this node with: Gmail Trigger → download PDF → extract text\nreturn [{ json: { invoiceText: `INVOICE\\nAcme Supplies Inc.\\nInvoice #: INV-2026-0042\\nDate: 2026-07-15\\nDue: 2026-08-14\\nBill To: Your Company\\n\\nItem              Qty   Price\\nWidget A           10   $25.00 = $250.00\\nWidget B            5   $40.00 = $200.00\\n\\nSubtotal: $450.00\\nTax (10%): $45.00\\nTotal: $495.00 USD\\nTerms: Net 30`, source: 'demo' } }];"
      },
      "id": "t3-input",
      "name": "Invoice Text (edit me)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "models/gemini-2.0-flash"
        },
        "messages": {
          "values": [
            {
              "content": "=Extract structured data from this invoice. Return ONLY JSON:\n{\"vendor\":\"\",\"invoiceNumber\":\"\",\"invoiceDate\":\"YYYY-MM-DD\",\"dueDate\":\"YYYY-MM-DD or null\",\"currency\":\"USD\",\"lineItems\":[{\"description\":\"\",\"quantity\":0,\"unitPrice\":0,\"total\":0}],\"subtotal\":0,\"tax\":0,\"total\":0,\"paymentTerms\":\"\"}\n\nINVOICE:\n{{ $json.invoiceText }}\n\nAll amounts as plain numbers. No markdown. Only the JSON object."
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "id": "t3-gemini",
      "name": "AI: Extract Fields",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        520,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "googlePalmApi": {
          "id": "REPLACE_ME",
          "name": "Google Gemini"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.content?.parts?.filter(p=>!p.thought).map(p=>p.text||'').join('') ?? $json.text ?? '';\nconst cleaned = raw.replace(/```json/gi,'').replace(/```/g,'').trim();\nlet data = null;\nfor (const c of (cleaned.match(/\\{[\\s\\S]*\\}/g)||[]).reverse()) { try { const p=JSON.parse(c); if(p&&p.vendor){data=p;break;} } catch(e){} }\nif(!data) return { json: { error: 'Could not parse', raw } };\nreturn { json: data };"
      },
      "id": "t3-parse",
      "name": "Parse Extraction",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        0
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Invoice Ledger"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "id": "t3-sheets",
      "name": "Sheets: Log to Ledger",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1040,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Sheets account"
        }
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Invoice Text (edit me)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Invoice Text (edit me)": {
      "main": [
        [
          {
            "node": "AI: Extract Fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI: Extract Fields": {
      "main": [
        [
          {
            "node": "Parse Extraction",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Extraction": {
      "main": [
        [
          {
            "node": "Sheets: Log to Ledger",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}